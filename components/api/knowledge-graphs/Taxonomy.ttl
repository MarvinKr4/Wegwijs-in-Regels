wir:rijksarchivaris
    a beg-sbb:Concept ;
    beg-sbb:Label "Rijksarchivaris" ;
    beg-sbb:Definition
        "Een rijksarchivaris beheert de rijksarchiefbewaarplaats van een provinciehoofdstad en moet in bezit zijn van een diploma Archivistiek." ;
    beg-sbb:Source lido:BWBR0007376%2F1214594%2F2001-03-21%2F2001-03-21 ;                     #artikel 25 archiefwet
    wir:wetcontext lido:BWBR0007376%2F1215304%2F2024-06-19%2F2024-06-19 .                     #archiefwet1995


wir:rijksarchiefplaats
    a beg-sbb:Concept ;
    beg-sbb:Label "Rijksarchiefbewaarplaats" ;
    beg-sbb:Definition
        "Ruimte waarheen archiefbescheiden (van Rijksoverheidsorganen) ter blijvende bewaring zijn overgebracht en die voldoet aan de eisen als gesteld in de Regeling bouw en inrichting van archiefruimten en archiefbewaarplaatsen." ;
    beg-sbb:Source lido:BWBR0007376%2F1214604%2F2013-01-01%2F2013-01-01 ;                     #artikel 26 archiefwet
    beg-sbb:BroaderGeneric wir:archiefbewaarplaats ;
    wir:wetcontext lido:BWBR0007376%2F1215304%2F2024-06-19%2F2024-06-19 .                     #archiefwet1995


wir:provinarchiefplaats
    a beg-sbb:Concept ;
    beg-sbb:Label "Provinciale Archiefbewaarplaats" ;
    beg-sbb:Definition
        "Archiefbewaarplaats bedoeld voor de archiefbescheiden van de provinciale organen" ;
    beg-sbb:Source lido:BWBR0007376%2F1214644%2F2020-01-01%2F2020-01-01 ;                     #artikel 29 archiefwet
    beg-sbb:BroaderGeneric wir:archiefbewaarplaats ;
    wir:wetcontext lido:BWBR0007376%2F1215304%2F2024-06-19%2F2024-06-19 .                     #archiefwet1995


wir:provinarchivaris
    a beg-sbb:Concept ;
    beg-sbb:Label "Provinciearchivaris" ;
    beg-sbb:Definition
        "De provinciearchivaris beheert de provinciale archiefbewaarplaats en houdt toezicht op de naleving van de wettelijke regels voor het beheer van de niet-overgebrachte provinciale archieven" ;
    beg-sbb:Source lido:BWBR0007376%2F1214644%2F2020-01-01%2F2020-01-01 ;                     #artikel 29 archiefwet
    wir:wetcontext lido:BWBR0007376%2F1215304%2F2024-06-19%2F2024-06-19 .                     #archiefwet1995


wir:gemeentearchiefplaats
    a beg-sbb:Concept ;
    beg-sbb:Label "Gemeentelijke archiefbewaarplaats" ;
    beg-sbb:Definition
        "Archiefbewaarplaats bedoeld voor de archiefbescheiden van de gemeentelijke organen" ;
    beg-sbb:Source lido:BWBR0007376%2F1214664%2F1998-01-01%2F1998-01-01 ;                     #artikel 30 archiefwet
    beg-sbb:BroaderGeneric wir:archiefbewaarplaats ;
    wir:wetcontext lido:BWBR0007376%2F1215304%2F2024-06-19%2F2024-06-19 .                     #archiefwet1995


wir:gemeentearchivaris
    a beg-sbb:Concept ;
    beg-sbb:Label "Gemeente archivaris" ;
    beg-sbb:Definition
        "De gemeentearchivaris beheert de gemeentelijke archiefbewaarplaats en houdt toezicht op de naleving van wettelijke regels voor het beheer van de niet-overgebrachte gemeentearchieven." ;
    beg-sbb:Source lido:BWBR0007376%2F1214684%2F2020-01-01%2F2020-01-01 ;                     #artikel 32 archiefwet
    wir:wetcontext lido:BWBR0007376%2F1215304%2F2024-06-19%2F2024-06-19 .                     #archiefwet1995


wir:waterarchiefplaats
    a beg-sbb:Concept ;
    beg-sbb:Label "Waterschapsarchiefbewaarplaats" ;
    beg-sbb:Definition
        "Archiefbewaarplaats bedoeld voor de archiefbescheiden van de organen van het waterschap" ;
    beg-sbb:Source lido:BWBR0007376%2F1214724%2F1998-01-01%2F1998-01-01 ;                      #artikel 35 archiefwet
    wir:wetcontext lido:BWBR0007376%2F1215304%2F2024-06-19%2F2024-06-19 .                      #archiefwet1995


