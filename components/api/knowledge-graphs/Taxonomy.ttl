wir:onderneming
    a beg-sbb:Concept ;
    beg-sbb:Label "Onderneming" ;
    beg-sbb:Definition 
        "" ;
    beg-sbb:BroaderGeneric 
        wir:kleinonderneming ,
        wir:middelonderneming ,
