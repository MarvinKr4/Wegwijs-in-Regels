wir:adviescollegeopeninfo
    a beg-sbb:Concept ;
    beg-sbb:Label "AdviesCollege openbaarheid en informatiehuishouding" ;
    beg-sbb:Definition
        "" ;
    beg-sbb:Source lido:BWBR0045754%2F16046244%2F2022-05-01%2F2022-05-01 ;        #artikel 7.1 woo
    wir:wetcontext lido:BWBR0045754%2F16045964%2F2024-08-01%2F2024-08-01 .        #wet open overheid


wir:strafbepaling
    a beg-sbb:Concept ;
    beg-sbb:Label "Strafbepaling voor het overtreden van voorwaarden" ;
    beg-sbb:Definition 
        "Overtreding van een voorwaarde die op grond van artikel 5.5, vierde lid, artikel 5.6, derde lid of artikel 5.7 tweede of derde lid, aan een verstrekking is verbonden, wordt gestraft met gevangenisstraf van ten hoogste een jaar of geldboete van de vierde categorie." ;
    beg-sbb:ScopeNote
        "Het strafbaar gestelde feit is een misdrijf." ;
    beg-sbb:Source lido:BWBR0045754%2F16045194%2F2022-05-01%2F2022-05-01 ;        #artikel 8.1 woo
    wir:opGrondVan
        lido:BWBR0045754%2F16045154%2F2022-05-01%2F2022-05-01 ,                   #artikel 5.5 woo
        lido:BWBR0045754%2F16045164%2F2022-05-01%2F2022-05-01 ,                   #artikel 5.6 woo
        lido:BWBR0045754%2F16045174%2F2022-05-01%2F2022-05-01 ;                   #artikel 5.7 woo
    wir:wetcontext lido:BWBR0045754%2F16045964%2F2024-08-01%2F2024-08-01 .        #wet open overheid



wir:beslissingopbezwaar
    a beg-sbb:Concept ;
    beg-sbb:Label "Beslissing op bezwaar" ;
    beg-sbb:AltLabel "BOB" ;
    beg-sbb:Definition 
        "Een beslissing van een bestuursorgaan naar aanleiding van een bezwaarschrift. Het bestuursorgaan kan met de BOB bij een gegrond bezwaar het bestreden besluit herroepen en zo nodig een nieuw besluit daarvoor in de plaats stellen." ;
    beg-sbb:Source "https://wooincijfers.open-overheid.nl/footer/Definities" ;
    wir:wetcontext lido:BWBR0045754%2F16045964%2F2024-08-01%2F2024-08-01 .        #wet open overheid


wir:bezwaar
    a beg-sbb:Concept ;
    beg-sbb:Label "Bezwaar" ;
    beg-sbb:Definition
        "Bezwaar is protest van een belanghebbende tegen bepaald overheidshandelen. In de regel kan een belanghebbende bezwaar maken tegen een beslissing door een bezwaarschrift in te dienen bij de organisatie die de beslissing heeft genomen." ;
    beg-sbb:Source "https://wooincijfers.open-overheid.nl/footer/Definities" ;
    wir:wetcontext lido:BWBR0045754%2F16045964%2F2024-08-01%2F2024-08-01 .        #wet open overheid


wir:hotspot
    a beg-sbb:Concept ;
    beg-sbb:Label "Hotspot" ;
    beg-sbb:Definition
        "Een of meerdere gebeurtenissen die een opvallende of intensieve interactie tussen overheid en burger of tussen burgers onderling veroorzaken, waarvan de informatie wordt opgenomen in een blijvend te bewaren hotspotdossier." ;
    beg-sbb:Source "https://wooincijfers.open-overheid.nl/footer/Definities" ;
    wir:wetcontext lido:BWBR0045754%2F16045964%2F2024-08-01%2F2024-08-01 .        #wet open overheid


wir:informatieobj
    a beg-sbb:Concept ;
    beg-sbb:Label "Informatieobject" ;
    beg-sbb:Definition 
        "Een geheel van gegevens met een eigen identiteit: met een eigen naam of identificatiekenmerk." ;
    beg-sbb:ScopeNote 
        "In tegenstelling tot het meer gangbare begrip 'document' maakt het niet uit welke vorm een informatieobject aanneemt: papieren brieven, Word-documenten, e-mails, video's, tweets, websites en foto's." ;
    beg-sbb:Source "https://wooincijfers.open-overheid.nl/footer/Definities" ;
    beg-sbb:NarrowerGeneric wir:document ;
    wir:wetcontext lido:BWBR0045754%2F16045964%2F2024-08-01%2F2024-08-01 .        #wet open overheid


wir:bezwaarntb
    a beg-sbb:Concept ;
    beg-sbb:Label "Bezwaar Niet Tijdig Beslist" ;
    beg-sbb:AltLabel
        "NTB" ,
        "beroep NTB" ;
    beg-sbb:Definition 
        "Niet tijdig beslist. Bezwaar- en beroepsprocedures die zijn ingesteld, omdat het bestuursorgaan het gevraagde besluit (nog) niet heeft genomen, terwijl de beslistermijn is verstreken." ;
    beg-sbb:Source "https://wooincijfers.open-overheid.nl/footer/Definities" ;
wir:wetcontext lido:BWBR0045754%2F16045964%2F2024-08-01%2F2024-08-01 .        #wet open overheid


wir:opschorting
    a beg-sbb:Concept ;
    beg-sbb:Label "Opschorting" ;
    beg-sbb:Definition 
        "Bij opschorting wordt de beslistermijn niet verlengd, maar onderbroken." ;
    beg-sbb:ScopeNote "Opschorting vindt plaats wanneer een belanghebbende die naar verwachting bedenkingen heeft bij de beschikking van een Woo-verzoek de tijd krijgt om een zienswijze (reactie) naar voren te brengen. Ook kan de beslistermijn worden opgeschort wanneer een nadere omschrijving aan de verzoeker is gevraagd. Tot slot kan tijdens de afhandeling van een Woo-verzoek of een inhoudelijk bezwaarschrift een langere beslistermijn worden afgesproken en vastgelegd met de verzoeker." ;
     beg-sbb:Source "https://wooincijfers.open-overheid.nl/footer/Definities" ;
wir:wetcontext lido:BWBR0045754%2F16045964%2F2024-08-01%2F2024-08-01 .        #wet open overheid


wir:registerwoo
    a beg-sbb:Concept ;
    beg-sbb:Label "Register" ;
    beg-sbb:Definition
        "het register van overheidsorganisaties als bedoeld in Stb. 1859, 50 " ;
    beg-sbb:Source lido:BWBR0050243%2F2024-11-01%2F0 ;                      # is een regeling die nog aan de LiDO database moet toegevoegd worden
    wir:wetcontext lido:BWBR0045754%2F16045964%2F2024-08-01%2F2024-08-01 .    #wet open overheid




















wir:persoonsgegevens
    a beg-sbb:Concept ;
    beg-sbb:Label "Persoonsgegevens" ;
    wir:context [   wir:wetcontext lido:BWBR0045754%2F16045964%2F2024-08-01%2F2024-08-01 ;        #wet open overheid
                    beg-sbb:Definition "Betreft als bedoeld in paragraaf 3.1 onderscheidenlijk paragraaf 3.2 van de Uitvoeringswet Algemene verordening gegevensbescherming, tenzij de betrokkene uitdrukkelijk toestemming heeft gegeven voor de openbaarmaking van deze persoonsgegevens of deze persoonsgegevens kennelijk door de betrokkene openbaar zijn gemaakt" ;
                    beg-sbb:Source lido:BWBR0045754%2F16045104%2F2022-05-01%2F2022-05-01 ;        #artikel 5.1 woo
                    wir:naderToegelicht
                        lido:BWBR0040940%2F14570024%2F2018-05-25%2F2018-05-25 ,                   #paragraaf 3.1 AVG
                        lido:BWBR0040940%2F14570064%2F2018-05-25%2F2018-05-25 ;                   #paragraaf 3.2 AVG
                ] ,
                [
                    wir:wetcontext lido:BWBR0040940%2F14570354%2F2021-07-01%2F2021-07-01 ;       #Uitvoeringswet AVG
                    beg-sbb:Definition "alle informatie over een geïdentificeerde of identificeerbare natuurlijke persoon („de betrokkene”); als identificeerbaar wordt beschouwd een natuurlijke persoon die direct of indirect kan worden geïdentificeerd, met name aan de hand van een identificator zoals een naam, een identificatienummer, locatiegegevens, een online identificator of van een of meer elementen die kenmerkend zijn voor de fysieke, fysiologische, genetische, psychische, economische, culturele of sociale identiteit van die natuurlijke persoon" ;
                    beg-sbb:Source eurlex:reg%2F2016%2F679%2Foj%2Feng;
                ] .



wir:bijzcatpersoon
    a beg-sbb:Concept ;
    beg-sbb:Label "Bijzonder Categorie Persoonsgegevens" ;
    beg-sbb:BroaderGeneric wir:persoonsgegevens ;
    beg-sbb:Definition 
        "de categorieën van persoonsgegevens, bedoeld in artikel 9, eerste lid, van de verordening" ;
    beg-sbb:Source lido:BWBR0040940%2F14569674%2F2018-05-25%2F2018-05-25 ;        #artikel 1 Uitvoeringswet AVG
    wir:naderToegelicht lido:BWBR0040940%2F14569774%2F2018-05-25%2F2018-05-25 ;    #artikel 9 Uitvoeringswet AVG
    wir:wetcontext lido:BWBR0040940%2F14570354%2F2021-07-01%2F2021-07-01 .                      #Uitvoeringswet AVG


wir:persoonstrafaard
    a beg-sbb:Concept ;
    beg-sbb:Label "Persoonsgegevens van strafrechtelijke aard" ;    
    beg-sbb:BroaderGeneric wir:persoonsgegevens ;
    beg-sbb:Definition 
        "persoonsgegevens betreffende strafrechtelijke veroordelingen en strafbare feiten of daarmee verband houdende veiligheidsmaatregelen als bedoeld in artikel 10 van de verordening, alsmede persoonsgegevens betreffende een door de rechter opgelegd verbod naar aanleiding van onrechtmatig of hinderlijk gedrag" ;
    beg-sbb:Source lido:BWBR0040940%2F14569674%2F2018-05-25%2F2018-05-25 ;        #artikel 1 Uitvoeringswet AVG
    wir:naderToegelicht lido:BWBR0040940%2F14569784%2F2020-01-01%2F2020-01-01 ;    #artikel 10 Uitvoeringswet AVG
    wir:wetcontext lido:BWBR0040940%2F14570354%2F2021-07-01%2F2021-07-01 .                      #Uitvoeringswet AVG


