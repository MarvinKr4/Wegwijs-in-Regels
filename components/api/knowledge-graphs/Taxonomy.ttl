wir:autoriteitpersgegevens
    a beg-sbb:Concept ;
    beg-sbb:Label "Autoriteit Persoonsgegevens" ;
    beg-sbb:Definition
        "De Autoriteit Persoonsgegevens is de onafhankelijke toezichthouder in Nederland die zich sterk maakt voor het recht op bescherming van persoongegevens" ;
    beg-sbb:Source lido:BWBR0040940%2F14569744%2F2018-05-25%2F2018-05-25 ;                    #artikel 6 AVG
    wir:wetcontext lido:BWBR0040940%2F14570354%2F2021-07-01%2F2021-07-01 .    
    


























wir:archief
    a beg-sbb:Concept ;
    beg-sbb:Label "Archief" ;
    beg-sbb:Definition
        "Onder archief verstaan we het geheel van archiefbescheiden, ontvangen of opgemaakt door een organisatie, persoon of groep personen als resultaat van zelfstandige archiefvorming." ;
    beg-sbb:ScopeNote
        "Je kunt een archief zien als de neerslag van activiteiten en taken, rechten en verplichtingen." ;
    wir:wetcontext lido:BWBR0007376%2F1215304%2F2024-06-19%2F2024-06-19 .         #archiefwet1995


wir:archiefbescheiden
    a beg-sbb:Concept ;
    beg-sbb:Label "Archiefbescheiden" ;
    beg-sbb:Definition
        "bescheiden, ongeacht hun vorm, die door de overheidsorganen ontvanen of opgemaakt zijn en naar hun aard bestemd daaronder te berusten" ;
    beg-sbb:ScopeNote
        "bescheiden, ongeacht hun vorm, met overeenkomstige bestemming, ontvangen of opgemaakt door instelling of personen, wier rechten of functies op enig overheidsorgaan zijn overgegaan" ,
        "bescheiden, ongeacht hun vorm, welke ingevolge overeenkomsten met of beschikkingen van instellingen of personen dan wel uit andere hoofde in een archiefbewaarplaats zijn opgenomen om daar te berusten." ,
        "reprodukties, ongeacht hun vorm, welke bij of krachtens de wet in de plaats zijn gesteld van eerder bedoelde archiefbescheiden of welke op grond van het bepaalde in artikel 7 zijn vervaardigd." ;
    beg-sbb:Source lido:BWBR0007376%2F1214334%2F2004-02-13%2F2004-02-13 ;                     #artikel 1 archiefwet
    wir:naderToegelicht wir:archiefbewaarplaats ;
    wir:opGrondVan lido:BWBR0007376%2F1214404%2F2013-01-01%2F2013-01-01 .                     #artikel 7 archiefwet


wir:archiefruimte
    a beg-sbb:Concept ;
    beg-sbb:Label "Archiefruimte" ;
    beg-sbb:Definition
        "Archiefdepot bestemd voor de bewaring door de archiefvormer van recente archiefbescheiden" ;
    beg-sbb:ScopeNote "Een archiefruimte is over het algemeen een ruimte voor de bewaring van archiefbescheiden. Organisaties gebruiken deze ruimte vooral voor archiefbescheiden die niet meer dagelijks gebruikt worden. Vaak zijn er voorzieningen om deze te beschermen tegen calamiteiten en te beveiligen tegen onbevoegd gebruik." ;    
    beg-sbb:Source lido:BWBR0007376%2F1214334%2F2004-02-13%2F2004-02-13 ;                     #artikel 1 archiefwet
    wir:wetcontext lido:BWBR0007376%2F1215304%2F2024-06-19%2F2024-06-19 .                     #archiefwet1995


wir:archiefbewaarplaats
    a beg-sbb:Concept ;
    beg-sbb:Label "Archiefbewaarplaats" ;
    beg-sbb:Definition 
        "Archiefdepot of geheel van archiefdepots gebouwd en ingericht voor de bijvende bewaring van archiefbescheiden" ;
    beg-sbb:ScopeNote 
        "De organisatorische betekenis is een archiveringssysteem van de overheid voor blijvend te bewaren archiefbescheiden." ,
        "De technische betekenis is de fysieke ruimte binnen de organisatie waar de archiefbeschieden, vaak in fysieke vorm, bewaard worden." ;
    beg-sbb:Source lido:BWBR0007376%2F1214334%2F2004-02-13%2F2004-02-13 ;                     #artikel 1 archiefwet
    wir:wetcontext lido:BWBR0007376%2F1215304%2F2024-06-19%2F2024-06-19 .                     #archiefwet1995


