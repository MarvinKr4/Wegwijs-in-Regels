wir:naderToegelicht
    a skos:concept ;
    rdfs:label "wordt nader toegelicht in" ;
    skos:definition "Een begrip wordt nader toegelicht in een ander lid, artikel of andere wet" .

wir:wetcontext
    a skos:concept ;
    rdfs:label "is context van wet" ;
    skos:definition "Een begrip of regeling moet gebruikt worden in de context van een specifieke wet" .


wir:context 
    a skos:concept ;
    rdfs:label "context" ;
    skos:definition "context van een woord wat de definitie bepaald" .


wir:opGrondVan
    a skos:concept ;
    rdfs:label "Op grond van" ;
    skos:definition "Een artikel stelt een voorwaarde, verplichting of verbod op grond van het verwezen artikel" .









wir:document 
    a beg-sbb:Concept ;
    beg-sbb:Label "Document" ;
    beg-sbb:Definition 
        "Een door een orgaan, persoon of college als bedoeld in artikel 2.2, eerste lid, opgemaakt of ontvangen schriftelijk stuk of ander geheel van vastgelegde gegevens dat naar zijn aard verband houdt met de publieke taak van dat orgaan, die persoon of dat college."@nl ;
    beg-sbb:Source lido:BWBR0045754%2F16044914%2F2022-05-01%2F2022-05-01 ;        #artikel 2.1 woo
    wir:naderToegelicht lido:BWBR0045754%2F16044924%2F2022-05-01%2F2022-05-01 .    #artikel 2.2 woo


wir:milieuinformatie
    a beg-sbb:Concept ;
    beg-sbb:Label "Milieu-informatie" ;
    beg-sbb:Definition 
        "hetgeen daaronder wordt verstaan in artikel 19.1a van de Wet milieubeheer" ;
    beg-sbb:Source lido:BWBR0045754%2F16044914%2F2022-05-01%2F2022-05-01 ;    #artikel 2.1 woo
    wir:naderToegelicht lido:BWBR0003245%2F6225104%2F2022-05-01%2F2022-05-01 . #artikel 19.1a wet mileeubeheer


wir:publiekeinfo
    a beg-sbb:Concept ;
    beg-sbb:Label "Publieke informatie" ;
    beg-sbb:Definition
        "informatie neergelegd in documenten die berusten bij een orgaan, persoon of college als bedoeld in artikel 2.2, eerste lid, of informatie die krachtens artikel 2.3 door een bestuursorgaan kan worden gevorderd." ;
    beg-sbb:Source lido:BWBR0045754%2F16044914%2F2022-05-01%2F2022-05-01 ;            #artikel 2.1 woo
    wir:naderToegelicht lido:BWBR0045754%2F16044924%2F2022-05-01%2F2022-05-01 ,       #artikel 2.2 woo
                        wir:document,
                        wir:bestuursorgaan .       


wir:bestuursorgaan
    a beg-sbb:Concept ;
    beg-sbb:Label "Bestuursorgaan" ;
    beg-sbb:Definition 
        "Een orgaan van een rechtspersoon die krachtens publiekrechts is ingesteld of een ander persoon of college, met enig openbaar gezag bekleed" ;
    beg-sbb:Source lido:BWBR0005537%2F2813914%2F2020-01-01%2F2020-01-01 .              #artikel 1.1 AWB



wir:zorgplicht
    a beg-sbb:Concept ;
    beg-sbb:Label "Zorgplicht" ;
    wir:context [ wir:wetcontext lido:BWBR0045754%2F16045964%2F2024-08-01%2F2024-08-01 ;          #wet open overheid
                  beg-sbb:Definition "Een bestuursorgaan draagt er zorg voor dat de documenten die het ontvangt, vervaardigt of anderszins onder zich heeft, zich in goed, geordende en toegankelijke staat bevinden." ;
                  beg-sbb:ScopeNote "Een bestuursorgaan draagt er zoveel mogelijk zorg voor dat de informatie die het overeenkomstig deze wet verstrekt, actueel, nauwkeurig en vergelijkbaar is." ;
                  beg-sbb:Source lido:BWBR0045754%2F16044944%2F2024-06-19%2F2024-06-19          #artikel 2.4 woo 
                ] ,
                [ wir:wetcontext lido:BWBR0007376%2F1215304%2F2024-06-19%2F2024-06-19 ;           #archiefwet1995
                  beg-sbb:Definition "Zorgdragers moeten de archiefbescheiden die onder hen berusten, in goede, geordende en toegankelijke staat brengen en bewaren." ;
                  beg-sbb:ScopeNote "Ook zijn zorgdragers verplicht om zorg te dragen voor de vernietiging van de archiefbescheiden die daarvoor in aanmerking komen" ;
                  beg-sbb:Source lido:BWBR0007376%2F1214364%2F1996-01-01%2F1996-01-01            #artikel 3 archiefwet
                ] .
   


wir:zorgdrager 
    a beg-sbb:Concept ;
    beg-sbb:Label "Zorgdrager" ;
    wir:context [ wir:wetcontext lido:BWBR0045754%2F16045964%2F2024-08-01%2F2024-08-01 ;          #wet open overheid
                  beg-sbb:Definition "Een orgaan van een rechtpersoon die krachtens publiekrecht is ingesteld of een aner person of college, met enig openbaar gezag bekleed." ;
                  beg-sbb:Source lido:BWBR0005537%2F2813914%2F2020-01-01%2F2020-01-01 ;           #Algemene wet bestuursrecht, Artikel 1:1
                ],
                [ wir:wetcontext lido:BWBR0007376%2F1215304%2F2024-06-19%2F2024-06-19 ;           #archiefwet1995
                  beg-sbb:Definition "Functionaris of organisatie belast met archiefzorg." ;
                ] .



wir:toegankelijkewijze
    a beg-sbb:Concept ;
    beg-sbb:Label "Toegankelijke wijze" ;
    beg-sbb:Definition 
        "Het openbaar maken van informatie overenkomstig deze wet op zodanige wijze dat: de belanghebbende en belangstellende burger zoveel mogelijk wordt bereikt; de vorm voor het hergebruik beschikbaar is; of in andere electronische vorm, of door verstrekking van een kopie of door een uittreksel of samenvatting van de inhoud te geven." ;
    wir:naderToegelicht wir:openbaarmaking ;
    beg-sbb:Source lido:BWBR0045754%2F16044944%2F2024-06-19%2F2024-06-19 .         #artikel 2.4 woo 



wir:openbaarmaking
    a beg-sbb:Concept ;
    beg-sbb:Label "Openbaarmaking" ;
    beg-sbb:Definition 
        "Een bestuursorgaan zorgt ervoor dat de documenten die het ontvangt, vervaardigt of anderszins onder zich heeft, zich in goede, geordende en toegankelijke staat bevinden" ;
    beg-sbb:Source lido:BWBR0045754%2F16044944%2F2024-06-19%2F2024-06-19 ;        #artikel 2.4 woo
    wir:wetcontext lido:BWBR0045754%2F16045964%2F2024-08-01%2F2024-08-01 ;
    wir:naderToegelicht wir:bestuursorgaan ;
    wir:naderToegelicht wir:document ;
    beg-sbb:NarrowerGeneric wir:actiefopen ;
    beg-sbb:NarrowerGeneric wir:verzoekopen .


wir:actiefopen
    a beg-sbb:Concept ;
    beg-sbb:Label "Actieve openbaarmaking" ;
    beg-sbb:Definition
        "Het uit eigen beweging de bij het bestuursorgaan berustende informatie neergelegd in documenten voor eenieder openbaar maken" ;
    beg-sbb:Source lido:BWBR0045754%2F16044974%2F2022-05-01%2F2022-05-01 ;        #artikel 3.1 woo
    wir:wetcontext lido:BWBR0045754%2F16045964%2F2024-08-01%2F2024-08-01 ;        #wet open overheid
    wir:naderToegelicht wir:bestuursorgaan ;
    wir:naderToegelicht wir:document ;
    beg-sbb:BroaderGeneric wir:openbaarmaking .



wir:catinfo
    a beg-sbb:Concept ;
    beg-sbb:Label "Categorieën informatie" ;
    beg-sbb:Definition
        "De in deze wet beschreven informatie die actief openbaar moet worden gemaakt door een bestuursorgaan" ;
    beg-sbb:Source lido:BWBR0045754%2F16044994%2F2022-05-01%2F2022-05-01 ;        #artikel 3.3 woo
    wir:naderToegelicht wir:bestuursorgaan ;
    wir:wetcontext lido:BWBR0045754%2F16045964%2F2024-08-01%2F2024-08-01 .        #wet open overheid



wir:verzoekopen
    a beg-sbb:Concept ;
    beg-sbb:Label "Openbaarmaking op verzoek" ;
    beg-sbb:Definition
        "Het op verzoek openbaar maken van publieke informatie door een bestuursorgaan" ;
    beg-sbb:Source lido:BWBR0045754%2F16045034%2F2022-05-01%2F2022-05-01 ;        #artikel 4.1 woo
    wir:wetcontext lido:BWBR0045754%2F16045964%2F2024-08-01%2F2024-08-01 ;        #wet open overheid
    wir:naderToegelicht wir:bestuursorgaan ;
    wir:naderToegelicht wir:publiekeinfo ;
    wir:naderToegelicht wir:verzoek ;
    beg-sbb:BroaderGeneric wir:openbaarmaking .




wir:verzoek
    a beg-sbb:Concept ;
    beg-sbb:Label "Verzoek" ;
    beg-sbb:Definition
        "Een mondelinge of schriftelijke kennisgeving aan een bestuursorgaan om publieke informatie te ontvangen" ;
    beg-sbb:Source lido:BWBR0045754%2F16045034%2F2022-05-01%2F2022-05-01 ;        #artikel 4.1 woo
    wir:naderToegelicht wir:bestuursorgaan ;
    wir:wetcontext lido:BWBR0045754%2F16045964%2F2024-08-01%2F2024-08-01 .        #wet open overheid




wir:verzoeker
    a beg-sbb:Concept ;
    beg-sbb:Label "Verzoeker" ;
    beg-sbb:Definition
        "De natuurlijke persoon die een verzoek heeft ingediend" ;
    beg-sbb:Source lido:BWBR0045754%2F16045034%2F2022-05-01%2F2022-05-01 ;        #artikel 4.1 woo
    wir:wetcontext lido:BWBR0045754%2F16045964%2F2024-08-01%2F2024-08-01 ;        #wet open overheid
    wir:naderToegelicht wir:verzoek .



wir:beslissingverzoek
    a beg-sbb:Concept ;
    beg-sbb:Label "Beslissing op een verzoek" ;
    beg-sbb:Definition
        "De mededeling van een bestuursorgaan aan de verzoeker of een verzoek wel of niet wordt ingewilligd" ;
    beg-sbb:Source lido:BWBR0045754%2F16045054%2F2022-05-01%2F2022-05-01 ;        #artikel 4.3 woo
    wir:naderToegelicht wir:bestuursorgaan ;
    wir:naderToegelicht wir:verzoeker ;
    wir:naderToegelicht wir:verzoek ;
    wir:wetcontext lido:BWBR0045754%2F16045964%2F2024-08-01%2F2024-08-01 .        #wet open overheid


wir:persbeleidsopvatting
    a beg-sbb:Concept ;
    beg-sbb:Label "Persoonlijke beleidsopvatting" ;
    beg-sbb:Definition
        "Persoonlijke beleidsopvattingen zijn ambtelijke adviezen, visies, standpunten en overwegingen ten behoeve van intern beraad, niet zijnde feiten, prognoses, beleidsalternatieven, de gevolgen van een bepaald beleidsalternatief of andere onderdelen met een overwegend objectief karakter." ;
    beg-sbb:Source lido:BWBR0045754%2F16045114%2F2022-05-01%2F2022-05-01 ;        #artikel 5.2 woo 
    wir:wetcontext lido:BWBR0045754%2F16045964%2F2024-08-01%2F2024-08-01 .        #wet open overheid
 


wir:uitzondering
    a beg-sbb:Concept ;
    beg-sbb:Label "Uitzondering" ;
    beg-sbb:Definition
        "Een situatie waarin het openbaar maken van informatie ingevolge deze wet achterwege blijft" ;
    wir:wetcontext lido:BWBR0045754%2F16045964%2F2024-08-01%2F2024-08-01 .        #wet open overheid


